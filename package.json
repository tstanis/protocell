{
  "name": "protocell",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "description": "A factory game built out of cell biology. See SPEC.md.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test:sim && npm run test:wire",
    "test:sim": "vitest run packages apps/client",
    "test:wire": "vitest run apps/server",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "server": "npm run dev --workspace @protocell/server",
    "client": "npm run dev --workspace @protocell/client",
    "sweep": "tsx scripts/sweep.ts",
    "play-intro": "node scripts/playIntro.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
