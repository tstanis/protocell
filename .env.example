# Copy to `.env` at the repo root and fill in. `.env` is gitignored; this file is not,
# so never put a real secret here.
#
#   cp .env.example .env
#
# Loaded automatically by the server (node's built-in process.loadEnvFile). Anything
# already set in the real environment wins, so a deployed platform's own secrets are
# never overridden by a file that happened to ship with the code.

# ── Google sign-in ───────────────────────────────────────────────────────────
# From https://console.cloud.google.com/apis/credentials — create an
# "OAuth 2.0 Client ID" of type "Web application".
#
# You do NOT need the Google Cloud *project id* anywhere; the client id and secret are
# the only things this server uses.
#
# Add this EXACT string as an Authorized redirect URI, including the port:
#   http://localhost:8787/auth/callback
#
# Leave both blank to run without sign-in: the server then behaves as it always has,
# anonymous with ?game=<id>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random one is generated at boot — which means every restart signs everyone
# out. Required when NODE_ENV=production.
SESSION_SECRET=

# ── Origins ──────────────────────────────────────────────────────────────────
# This server's own public origin. Must match the Google redirect URI exactly.
PUBLIC_ORIGIN=http://localhost:8787

# Where the browser is sent after a successful sign-in — i.e. the client.
APP_ORIGIN=http://localhost:5173

# Comma-separated browser origins allowed to call /auth/* with credentials.
# Defaults to APP_ORIGIN. A wildcard is not possible here: browsers reject
# Access-Control-Allow-Credentials together with Allow-Origin: *, precisely because it
# would let any site read a signed-in user's session.
ALLOWED_ORIGINS=http://localhost:5173

# ── Storage ──────────────────────────────────────────────────────────────────
# Where saved cells go. Leave GCS_BUCKET blank to use the local filesystem, which needs
# no credentials and no network — that is the default and the tested-by-default path.
#
# DATA_DIR=data/cells

# Set this and cells go to Google Cloud Storage instead. Verify with: npm run gcs:check
GCS_BUCKET=
# GCS_PREFIX=cells/

# Path to a service-account JSON key. A PATH, not the JSON itself: the key contains real
# newlines and a .env file is line-oriented, so pasting the JSON in does not work.
# Not needed when running ON Google Cloud with a service account attached to the instance.
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/protocell-sa.json

# Seconds between autosaves of a live cell. Transitions (disconnect, freeze, shutdown)
# always save immediately; this is only crash insurance, and it is priced in requests
# rather than bytes — every minute would be ~$60/month, five minutes is a few dollars.
# AUTOSAVE_S=300
# How many cells may stay resident in RAM. Defaults to 4x the live cap.
# MAX_RESIDENT_GAMES=

# ── Cloud Run deploy (npm run deploy) ────────────────────────────────────────
GCP_PROJECT=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=protocell
# Attach a service account with Storage Object Admin ON THE BUCKET, and no key file is
# needed in the deployment at all — the metadata server issues tokens directly.
CLOUD_RUN_SERVICE_ACCOUNT=
# CLOUD_RUN_MEMORY=2Gi
# CLOUD_RUN_CPU=2

# Secrets are mounted from Secret Manager BY REFERENCE, never passed as env vars: an
# env var lands in the service config in plaintext for anyone with project Viewer, and
# on the command line on the way there. These are the secret NAMES, not values.
#
#   npm run deploy -- --push-secrets    creates/updates them from the values above
#
# SECRET_GOOGLE_CLIENT_ID=protocell-google-client-id
# SECRET_GOOGLE_CLIENT_SECRET=protocell-google-client-secret
# SECRET_SESSION_SECRET=protocell-session-secret

# ── Simulation ───────────────────────────────────────────────────────────────
PORT=8787
# Frames per second sent to each attached client.
SEND_HZ=30
# How many cells may tick at once. Each costs ~5.5% of a core; the default is derived
# from the machine's core count, so only set this to override that.
# MAX_LIVE_GAMES=
